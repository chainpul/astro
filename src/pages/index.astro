---
// 1. Import fungsi untuk mengambil data koleksi
import { getCollection } from 'astro:content';

// 2. Ambil data dari folder src/content/posts
// Variabel 'allPosts' harus didefinisikan di sini
const allPosts = await getCollection('posts');
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Daftar Postingan</title>
    <style>
      body { font-family: sans-serif; padding: 40px; line-height: 1.6; }
      h1 { color: #333; }
      ul { list-style: none; padding: 0; }
      li { margin-bottom: 10px; background: #f4f4f4; padding: 10px; border-radius: 5px; }
      a { text-decoration: none; color: blue; font-weight: bold; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <h1>Blog Saya</h1>
    
    {allPosts.length === 0 && <p>Belum ada postingan.</p>}

    <ul>
      {allPosts.map((post) => (
        <li>
          {/* Gunakan post.id untuk link-nya */}
          <a href={`/posts/${post.id}`}>
            {post.data.title}
          </a>
          <br />
          <small>{post.data.publishDate}</small>
        </li>
      ))}
    </ul>

    <hr />
    <p><a href="/keystatic" style="color: green;">→ Buka Dashboard Admin</a></p>
  </body>
</html>