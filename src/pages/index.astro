---
// 1. Import fungsi untuk mengambil data koleksi
import { getCollection } from 'astro:content';

// 2. Ambil semua data dan urutkan berdasarkan tanggal terbaru
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chainpulse - Daftar Postingan</title>
    <style>
      body { font-family: 'Inter', sans-serif; max-width: 800px; margin: auto; padding: 20px; line-height: 1.6; background: #f4f7f6; color: #333; }
      h1 { color: #1a1a1a; text-align: center; margin-bottom: 30px; letter-spacing: -1px; }
      ul { list-style: none; padding: 0; }
      li { margin-bottom: 20px; background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: transform 0.2s; }
      li:hover { transform: translateY(-3px); }
      a { text-decoration: none; color: #2563eb; font-weight: bold; font-size: 1.2rem; display: block; margin-bottom: 5px; }
      a:hover { color: #1d4ed8; }
      small { color: #6b7280; font-size: 0.9rem; }
      hr { border: 0; border-top: 1px solid #e5e7eb; margin: 40px 0; }
    </style>
  </head>
  <body>
    <h1>Chainpulse Blog</h1>
    
    {sortedPosts.length === 0 ? (
      <p style="text-align: center;">Belum ada postingan. Silakan buat postingan baru di dashboard.</p>
    ) : (
      <ul>
        {sortedPosts.map((post) => (
          <li>
            <a href={`/posts/${post.id}`}>
              {post.data.title}
            </a>
            <small>📅 {new Date(post.data.publishDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</small>
          </li>
        ))}
      </ul>
    )}

    <hr />
    <p style="text-align: center; font-size: 0.8rem; color: #9ca3af;">&copy; 2026 Chainpulse - All Rights Reserved</p>
  </body>
</html>