  <!-- Back to Top -->
  <button id="back-to-top" class="fixed bottom-6 right-6 w-10 h-10 bg-blue-600 text-white rounded-full shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-blue-700 z-50" title="Back to top">
    <i data-lucide="chevron-up" class="w-5 h-5"></i>
  </button>

  <script>
    // Initialize Lucide
    lucide.createIcons();

    // ===== READING PROGRESS BAR =====
    const progressBar = document.getElementById('progress-bar');
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      progressBar.style.width = (docHeight > 0 ? (scrollTop / docHeight) * 100 : 0) + '%';
    }

    // ===== BACK TO TOP =====
    const backToTop = document.getElementById('back-to-top');
    function updateBackToTop() {
      if (window.scrollY > 600) {
        backToTop.classList.remove('opacity-0', 'pointer-events-none');
        backToTop.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backToTop.classList.add('opacity-0', 'pointer-events-none');
        backToTop.classList.remove('opacity-100', 'pointer-events-auto');
      }
    }
    backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    // ===== ACTIVE TOC =====
    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = [];
    tocLinks.forEach(link => {
      const id = link.getAttribute('href').substring(1);
      const el = document.getElementById(id);
      if (el) sections.push({ id, el, link });
    });
    function updateActiveToc() {
      let current = null;
      for (const s of sections) {
        if (s.el.getBoundingClientRect().top <= 120) current = s.id;
      }
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href').substring(1) === current);
      });
    }

    // ===== RAF SCROLL =====
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateProgress(); updateBackToTop(); updateActiveToc(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    // ===== MOBILE MENU =====
    document.getElementById('mobile-menu-btn').addEventListener('click', () => {
      document.getElementById('mobile-menu').classList.toggle('hidden');
    });

    // ===== COPY LINK =====
    document.getElementById('copy-link-btn').addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(() => {
        this.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        this.classList.add('bg-green-100', 'text-green-600');
        setTimeout(() => {
          this.innerHTML = '<i data-lucide="link" class="w-4 h-4"></i>';
          this.classList.remove('bg-green-100', 'text-green-600');
          lucide.createIcons();
        }, 2000);
      });
    });

    // ===== SHARE BUTTONS =====
    const pt = encodeURIComponent(document.title);
    const pu = encodeURIComponent(window.location.href);
    document.querySelectorAll('.share-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = btn.dataset.platform;
        const urls = {
          twitter: `https://twitter.com/intent/tweet?text=${pt}&url=${pu}`,
          linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${pu}`,
          whatsapp: `https://wa.me/?text=${pt}%20${pu}`
        };
        if (urls[p]) window.open(urls[p], '_blank', 'noopener,noreferrer,width=600,height=400');
      });
    });

    // ===== FAQ ACCORDION =====
    document.querySelectorAll('.faq-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling;
        const chevron = btn.querySelector('.faq-chevron');
        const isOpen = answer.classList.contains('open');

        // Close all others
        document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
        document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('rotated'));
        document.querySelectorAll('.faq-toggle').forEach(t => t.setAttribute('aria-expanded', 'false'));

        if (!isOpen) {
          answer.classList.add('open');
          chevron.classList.add('rotated');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // ===== SUBSCRIBE =====
    const subBtn = document.getElementById('subscribe-btn');
    const subMsg = document.getElementById('subscribe-msg');
    const subInput = subBtn.previousElementSibling;
    subBtn.addEventListener('click', () => {
      const email = subInput.value.trim();
      if (!email || !email.includes('@')) {
        subMsg.textContent = 'Please enter a valid email.';
        subMsg.classList.remove('hidden', 'text-green-300');
        subMsg.classList.add('text-red-300');
        return;
      }
      subBtn.textContent = 'Sending...';
      subBtn.disabled = true;
      setTimeout(() => {
        subBtn.textContent = '✓ Subscribed!';
        subBtn.classList.add('bg-green-100', 'text-green-700');
        subInput.value = '';
        subMsg.textContent = 'You\'ll receive our weekly digest.';
        subMsg.classList.remove('hidden', 'text-red-300');
        subMsg.classList.add('text-green-300');
        setTimeout(() => {
          subBtn.textContent = 'Subscribe';
          subBtn.disabled = false;
          subBtn.classList.remove('bg-green-100', 'text-green-700');
          subMsg.classList.add('hidden');
        }, 4000);
      }, 1200);
    });

    // Init
    updateProgress();
    updateActiveToc();
  </script>

