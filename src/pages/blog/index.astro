---
import { getCollection } from 'astro:content';
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blog — RWAHQ</title>
  <meta name="description" content="Research articles on RWA tokenization, DeFi lending, and institutional crypto adoption.">
  <link rel="canonical" href="https://rwahq.dev/blog">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50 text-slate-900 font-sans antialiased">

  <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-gray-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-14">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center"><i data-lucide="activity" class="w-4 h-4 text-white"></i></div>
        <span class="font-bold text-gray-900 tracking-tight">RW<span class="text-blue-600">AHQ</span></span>
      </a>
      <div class="hidden md:flex items-center gap-6 text-sm text-gray-500">
        <a href="/blog" class="text-blue-600 font-medium">Blog</a>
        <a href="/market" class="hover:text-blue-600 transition-colors">Market</a>
        <a href="/learn" class="hover:text-blue-600 transition-colors">Learn</a>
        <a href="/tools" class="hover:text-blue-600 transition-colors">Tools</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Blog</h1>
    <p class="text-gray-500 mb-8">What we've been researching lately.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/blog/rwa-tokenization-guide" class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-md hover:border-gray-200 transition-all">
        <div class="h-40 bg-gradient-to-br from-blue-100 to-indigo-100 flex items-center justify-center"><i data-lucide="landmark" class="w-10 h-10 text-blue-300"></i></div>
        <div class="p-5">
          <p class="text-xs text-gray-400 mb-2">June 2, 2025</p>
          <h2 class="text-sm font-semibold text-gray-800 group-hover:text-blue-600 transition-colors leading-snug">RWA Tokenization: What's Actually Happening in 2025</h2>
        </div>
      </a>
      <a href="/blog/defi-lending-explained" class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-md hover:border-gray-200 transition-all">
        <div class="h-40 bg-gradient-to-br from-purple-100 to-indigo-100 flex items-center justify-center"><i data-lucide="layers" class="w-10 h-10 text-purple-300"></i></div>
        <div class="p-5">
          <p class="text-xs text-gray-400 mb-2">May 28, 2025</p>
          <h2 class="text-sm font-semibold text-gray-800 group-hover:text-blue-600 transition-colors leading-snug">DeFi Lending in 2025: How It Actually Works (And Where The Money Is)</h2>
        </div>
      </a>
      {sortedPosts.map((post) => (
        <a href={`/blog/${post.id}`} class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-md hover:border-gray-200 transition-all">
          <div class="h-40 bg-gradient-to-br from-gray-100 to-gray-50 flex items-center justify-center"><i data-lucide="file-text" class="w-10 h-10 text-gray-300"></i></div>
          <div class="p-5">
            <p class="text-xs text-gray-400 mb-2">{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
            <h2 class="text-sm font-semibold text-gray-800 group-hover:text-blue-600 transition-colors leading-snug line-clamp-2">{post.data.title}</h2>
          </div>
        </a>
      ))}
    </div>
  </div>

  <footer class="bg-gray-900 text-gray-400 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center"><i data-lucide="activity" class="w-3.5 h-3.5 text-white"></i></div>
        <span class="font-bold text-white text-sm">RW<span class="text-blue-400">AHQ</span></span>
      </div>
      <p class="text-xs text-gray-500">© 2025 RWAHQ. Not financial advice.</p>
      <a href="https://twitter.com/rwahq_io" class="hover:text-white transition-colors"><i data-lucide="twitter" class="w-4 h-4"></i></a>
    </div>
  </footer>

  <script is:inline>lucide.createIcons();</script>
</body>
</html>